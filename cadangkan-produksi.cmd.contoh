@echo off
REM ==========================================================================
REM  CADANGAN HARIAN BASIS DATA PRODUKSI KMB
REM ==========================================================================
REM  Salin jadi `cadangkan-produksi.cmd` (TANPA .contoh), lalu isi sandinya.
REM  Yang terisi sudah diabaikan .gitignore dan tidak akan ikut git.
REM
REM      copy cadangkan-produksi.cmd.contoh cadangkan-produksi.cmd
REM
REM  Cara menjadwalkannya ada di docs/CADANGAN.md.
REM
REM  BERKAS INI HARUS ASCII MURNI. Tanda pisah panjang, karakter kotak, dan
REM  panah bukan-ASCII membuat cmd.exe salah membaca barisnya lalu menjalankan
REM  potongan komentar sebagai perintah. Itu sudah terjadi sekali: penjagaan
REM  sandi di bawah ikut hancur, dan cadangan berjalan ke basis data yang salah
REM  lalu menulis dump ke dalam folder proyek.
REM ==========================================================================

REM  PORTA 5432, BUKAN 6543.
REM  6543 adalah pooler mode transaksi yang dipakai Vercel; pg_dump butuh satu
REM  sesi utuh dan skripnya akan menolak alamat itu. Ambil "Session pooler"
REM  dari Supabase, tombol Connect.
set DATABASE_URL=postgresql://postgres.pdlevnrhrabfxxdlzebc:GANTI-SANDI@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

REM  Simpan DI LUAR proyek, di folder OneDrive supaya ia tersalin keluar dari
REM  laptop ini sendiri. Cadangan yang hanya ada di satu mesin akan hilang
REM  bersama mesin itu.
set TUJUAN=C:\Users\gabri\OneDrive\cadangan-mar

REM  30 hari: satu periode gaji penuh plus dua minggu. Cukup untuk menyadari
REM  ada yang salah pada periode sebelumnya dan masih bisa mundur ke sana.
set SIMPAN=30

REM  Sandi yang belum diisi berhenti di sini, bukan nanti. Tanpa penjagaan ini
REM  tugas terjadwalnya gagal tiap malam dengan galat sambungan yang tidak
REM  menyebut sebabnya, dan tugas yang selalu merah adalah tugas yang berhenti
REM  dibaca orang.
echo %DATABASE_URL% | find "GANTI-SANDI" >nul
if not errorlevel 1 (
  echo.
  echo   BELUM SIAP: sandi basis data belum diisi.
  echo.
  echo   Buka berkas ini dan ganti GANTI-SANDI dengan sandi Supabase Anda:
  echo       %~f0
  echo.
  echo   Alamatnya: Supabase, tombol Connect, Session pooler, porta 5432.
  echo.
  exit /b 2
)

cd /d "%~dp0"
call npx tsx scripts/cadangkan.ts --ke "%TUJUAN%" --simpan %SIMPAN%

REM  Status keluar diteruskan supaya Task Scheduler menandainya GAGAL kalau
REM  gagal. Tugas terjadwal yang selalu tampak berhasil adalah cara paling umum
REM  sebuah cadangan berhenti diam-diam selama berbulan-bulan.
exit /b %ERRORLEVEL%
