# Multi-System Supabase PostgreSQL URLs
DATABASE_URL_KMB=postgresql://postgres.iuxojbxyhgusfzfqnjzg:Aurakha_200505@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
