# Salin jadi .env — JANGAN commit .env
#
# PORTA 5433, BUKAN 5432. Ini disengaja dan bukan salah ketik.
#
# Seluruh repo ini menganggap 5433 = basis data pengembangan yang boleh dirusak.
# Dua puluh dua skrip dan `npm test` MENOLAK berjalan kalau DATABASE_URL bukan
# 5433 — karena uji integrasi menjalankan TRUNCATE work_orders. Pagar itu yang
# memisahkan "mengosongkan basis data uji" dari "mengosongkan basis data yang
# dipakai menggaji orang".
#
# Sampai 17 Sep 2026 berkas ini menulis 5432 dan nama basis data `kmb_project`.
# Keduanya salah: yang dipakai adalah 5433 dan `mar_project`. Siapa pun yang
# menyalin berkas ini akan ditolak oleh tiap pagar tanpa tahu sebabnya.
#
DATABASE_URL=postgres://postgres@127.0.0.1:5433/mar_project
DB_POOL_MAX=10

# Mode Driver Backend: 'appscript' atau 'supabase'
BACKEND_DRIVER=appscript
APPSCRIPT_URL=https://script.google.com/macros/s/AKfycbwlwlQvOGVF6FdKkYRNlbgdJCets5L-0AfufMB4_79_HzvoQkeE9aZAqkKZiXCZHXnG6Q/exec
