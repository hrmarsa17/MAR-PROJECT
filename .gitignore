node_modules/
dist/
.env
.env.*
# Templat BOLEH ikut — isinya tempat isian, dan tanpanya `cp
# .env.produksi.example .env.produksi` di PENERAPAN.md menyalin berkas yang
# tidak ada. `!.env.example` saja tidak cukup: ia tidak mengenai
# `.env.produksi.example`, yang karena itu tak pernah ikut ter-commit.
!.env*.example
*.log
.DS_Store
coverage/
.vitest/
.next/
next-env.d.ts
*.tsbuildinfo

# Berkas payroll SUNGGUHAN dari KMB V2 — acuan bentuk export, bukan bagian
# proyek. Isinya nama dan gaji orang yang benar-benar bekerja di sana; sekali
# masuk git ia ada di riwayat selamanya, termasuk di salinan siapa pun yang
# kelak meng-clone repo ini. Dibaca lewat `npx tsx scripts/baca-xlsx.ts`.
*.xlsx

# Cadangan basis data. Isinya SELURUH tabel produksi — nama, peran, token yang
# disimpan terbaca, dan tiap rupiah yang pernah dibayarkan. Direktori bawaan
# `scripts/cadangkan.ts` ada di dalam proyek, jadi tanpa baris ini satu
# `git add -A` sudah cukup untuk mengirim seluruh basis data ke GitHub.
cadangan/
*.dump

# Berkas penjadwal cadangan memuat alamat basis data produksi beserta sandinya.
# Templatnya (.contoh) yang ikut repo, bukan yang terisi.
cadangkan-produksi.cmd
.vercel
