# ════════════════════════════════════════════════════════════════════════════
# Salin jadi `.env.produksi` DI SERVER. Jangan pernah di-commit.
# ════════════════════════════════════════════════════════════════════════════
#   cp .env.produksi.example .env.produksi
#   nano .env.produksi
#   docker compose --env-file .env.produksi up -d --build
# ════════════════════════════════════════════════════════════════════════════

# ── Basis data ──────────────────────────────────────────────────────────────
POSTGRES_DB=mar
POSTGRES_USER=mar

# Buat yang panjang dan acak — JANGAN diketik sendiri:
#     openssl rand -base64 32
# Kata sandi ini tidak pernah perlu diingat siapa pun; ia hanya dibaca compose.
POSTGRES_PASSWORD=GANTI-DENGAN-HASIL-openssl-rand-base64-32

# Jumlah koneksi maksimum dari aplikasi ke basis data. 10 cukup untuk puluhan
# orang; naikkan hanya kalau memang terlihat antre, bukan untuk berjaga-jaga —
# tiap koneksi memakan memori di sisi Postgres.
DB_POOL_MAX=10

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Buat tunnel di Cloudflare Zero Trust, tambahkan public hostname, dan arahkan
# servicenya ke http://app:3000. Token ini hanya disimpan di server.
CLOUDFLARE_TUNNEL_TOKEN=GANTI-DENGAN-TOKEN-TUNNEL

# Hanya diperlukan kalau menjalankan jalur langsung dengan:
# docker compose --profile direct --env-file .env.produksi up -d --build
DOMAIN=mar.contoh.co.id
EMAIL_TLS=nama@contoh.co.id
